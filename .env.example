# Local Next.js dev server. Composer supplies its own database binding.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# S3-compatible object storage (Jino). Values are available in the bucket settings.
S3_ENDPOINT=https://s3.example.com
S3_REGION=your-region
S3_BUCKET=your-bucket
S3_PREFIX=flexx
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.example.com/your-bucket
