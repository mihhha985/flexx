// use prisma-next
model Product {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String
  country     String
  isActive    Boolean           @default(true)
  variants    ProductVariant[]
  categoryId  Int
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([categoryId, isActive])
}

model ProductVariant {
  id         Int                  @id @default(autoincrement())
  productId  Int
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  colorName  String
  colorSlug  String
  colorHex   String
  price      Float
  avatar     String
  images     String[]
  isActive   Boolean              @default(true)
  order      Int
  sizes      ProductVariantSize[]
  orderItems OrderItem[]

  @@unique([productId, colorSlug])
  @@unique([productId, order])
  @@index([productId, isActive, order])
  @@check(expression: "price >= 0", name: "product_variant_price_nonnegative")
  @@check(expression: "\"order\" >= 0", name: "product_variant_order_nonnegative")
  @@map("product_variant")
}

model ProductVariantSize {
  id        Int            @id @default(autoincrement())
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  size      Int
  stock     Int            @default(0)

  @@unique([variantId, size])
  @@index([variantId])
  @@check(expression: "size >= 35 AND size <= 48", name: "product_variant_size_supported")
  @@check(expression: "stock >= 0", name: "product_variant_size_stock_nonnegative")
  @@map("product_variant_size")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  order    Int
  icon     String    @unique
  products Product[]
}

enum order_status {
  @@type("pg/text@1")

  pending   = "pending"
  confirmed = "confirmed"
  paid      = "paid"
  shipped   = "shipped"
  completed = "completed"
  cancelled = "cancelled"
}

model Order {
  id              Int          @id @default(autoincrement())
  publicId        String       @unique @default(uuid())
  status          order_status @default(pending)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  comment         String?
  total           Float
  items           OrderItem[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([status])
  @@index([customerEmail])
  @@check(expression: "total >= 0", name: "order_total_nonnegative")
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  productId   Int
  variantId   Int?
  productName String
  colorName   String
  colorSlug   String
  size        Int
  unitPrice   Float
  quantity    Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@check(expression: "\"unitPrice\" >= 0", name: "order_item_price_nonnegative")
  @@check(expression: "quantity > 0", name: "order_item_quantity_positive")
}
