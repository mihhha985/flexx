{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@10.9.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:reset": "node --env-file=.env scripts/prisma-reset.mjs",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "npm run build && npm run composer:deploy",
    "dev": "next dev",
    "dev:composer": "npm run build && npm run composer:dev",
    "lint": "eslint --no-warn-ignored src scripts *.ts *.mjs",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "seed": "node --env-file=.env --import tsx src/prisma/seed.ts",
    "skills:sync": "prisma skills sync || exit 0",
    "start": "node scripts/start-standalone.mjs",
    "postinstall": "prisma skills sync || exit 0",
    "prebuild": "npm run contract:emit",
    "format": "prettier --write src scripts *.ts *.mjs *.json *.md",
    "format:check": "prettier --check src scripts *.ts *.mjs *.json *.md",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@prisma/composer": "0.16.0",
    "@prisma/composer-prisma-cloud": "0.16.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "next": "16.3.5",
    "postcss": "^8.5.26",
    "react": "19.2.3",
    "react-aria-components": "^1.21.0",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "8.22.0",
    "prettier": "3.9.6",
    "prisma": "8.0.0-rc.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "effect": "4.0.0-rc.112",
    "hono": "4.13.7",
    "lodash": "4.18.1",
    "valibot": "1.5.0"
  }
}
