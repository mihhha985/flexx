{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:reset": "node --env-file=.env scripts/prisma-reset.mjs",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "npm run build && npm run composer:deploy",
    "dev": "next dev",
    "dev:composer": "npm run build && npm run composer:dev",
    "lint": "eslint",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "seed": "node --env-file=.env --import tsx src/prisma/seed.ts",
    "skills:sync": "prisma skills sync || exit 0",
    "start": "next start",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/composer": "0.16.0",
    "@prisma/composer-prisma-cloud": "0.16.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@tailwindcss/postcss": "^4.3.3",
    "alchemy": "2.0.0-beta.74",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "next": "16.1.6",
    "postcss": "^8.5.26",
    "react": "19.2.3",
    "react-aria-components": "^1.21.0",
    "react-dom": "19.2.3",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "latest",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "effect": "4.0.0-rc.112"
  }
}
